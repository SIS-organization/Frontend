# Frontend environment example
# Copy this file to .env and set your values.

# Base URL of the real backend API (with the /v1 prefix).
# Example: http://localhost:8000/v1
VITE_API_BASE_URL=http://localhost:8000/v1

# false = use the real backend (default). true = old local mock, which was NOT
# adapted to the current backend contract.
VITE_USE_MOCK_API=false

# Temporary login: id of the user from the backend `users` table, sent in the
# X-User-Id header until JWT authentication exists (Epic 3).
# Seed data: 1 Andrei (student), 2 Daria (student), 3 Elena (professor),
# 4 Administrator, 5 Vlad (external).
VITE_USER_ID=1
